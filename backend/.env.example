# Copy to .env for running the backend outside Docker Compose.
# When run via docker-compose, these are set in docker-compose.yml instead.

ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://yanextfab:yanextfab@localhost:5432/yanextfab

# Generate with: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-before-deploying-anywhere-real
JWT_LIFETIME_SECONDS=3600

# SMTP for password-recovery email. Defaults assume a local Mailpit instance
# (docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@yanextfab.dev
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SSL=false

FRONTEND_URL=http://localhost:3000

# Required for the AI agent example to call Claude. Leave empty to disable it locally.
ANTHROPIC_API_KEY=
# provider:model passed to LangChain's init_chat_model — change this to swap LLM providers.
LLM_MODEL=anthropic:claude-sonnet-5

# Set by docker-compose.yml to /shared/openapi.json; leave unset for native (non-Docker) dev.
OPENAPI_EXPORT_PATH=

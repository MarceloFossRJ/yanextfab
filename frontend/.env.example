# Copy to .env.local for native (non-Docker) development.
# When run via docker-compose, these are set in docker-compose.yml instead.

# Server-only: where the frontend reaches the backend. Never exposed to the browser.
API_URL=http://localhost:8000

# Server-only: where the backend writes openapi.json, watched to regenerate the API client.
OPENAPI_SCHEMA_PATH=../backend/openapi.json
